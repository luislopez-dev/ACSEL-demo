@model PolizaExpedienteResponseDto
@{
    var pol = Model.Cabecera;
    ViewData["Title"] = $"Póliza {pol.NumeroPoliza}";
    var fechaSiniestroSugerida = pol.FechaDesde.AddDays(15).ToString("yyyy-MM-dd");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-2">
        <h1 class="h4 fw-bold mb-0">@pol.NumeroPoliza</h1>
        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">@pol.Estado</span>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="panel-card p-4 h-100">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small fw-semibold text-uppercase">Asegurado</div>
                    <div class="fw-bold">@pol.NombreAsegurado</div>
                    <div class="font-mono text-muted small">@pol.DocumentoFiscal</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small fw-semibold text-uppercase">Producto</div>
                    <div class="fw-bold">@pol.NombreProducto</div>
                    <div class="font-mono text-muted small">Deducible: @pol.PctDeducible.ToString("N0")%</div>
                </div>
                <div class="col-12"><hr class="my-1"/></div>
                <div class="col-md-6">
                    <div class="text-muted small fw-semibold text-uppercase">Bien Asegurado</div>
                    <div class="fw-semibold">@pol.DescripcionBien</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small fw-semibold text-uppercase">Vigencia</div>
                    <div class="font-mono">@pol.FechaDesde.ToString("yyyy-MM-dd") - @pol.FechaHasta.ToString("yyyy-MM-dd")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Suma Asegurada:</span>
                    <span class="font-mono fw-bold">$@pol.SumaAsegurada.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Prima Neta:</span>
                    <span class="font-mono">$@pol.PrimaNeta.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Impuesto (@pol.PctImpuesto.ToString("N0")%):</span>
                    <span class="font-mono">$@pol.MontoImpuesto.ToString("N2")</span>
                </div>
            </div>
            <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                <span class="fw-bold">Prima Total:</span>
                <span class="font-mono fw-bold fs-5">$@pol.PrimaTotal.ToString("N2")</span>
            </div>
        </div>
    </div>
</div>

<!-- Recibos -->
<div class="panel-card overflow-hidden mb-4">
    <div class="px-4 py-3 border-bottom fw-semibold">Recibos</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th class="ps-4">Nº Recibo</th>
                <th>Cuota</th>
                <th>Vencimiento</th>
                <th class="text-end">Monto</th>
                <th>Estado</th>
                <th class="pe-4">Cobro</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var rec in Model.Recibos)
            {
                var recBadge = rec.Estado == "COBRADO"
                    ? "bg-success-subtle text-success-emphasis border border-success-subtle"
                    : "bg-warning-subtle text-warning-emphasis border border-warning-subtle";

                <tr>
                    <td class="ps-4 font-mono">@rec.NumeroRecibo</td>
                    <td class="font-mono">#@rec.NumeroCuota</td>
                    <td class="font-mono">@rec.FechaVencimiento.ToString("yyyy-MM-dd")</td>
                    <td class="text-end font-mono fw-semibold">$@rec.MontoTotal.ToString("N2")</td>
                    <td><span class="badge @recBadge">@rec.Estado</span></td>
                    <td class="pe-4">
                        @if (rec.Estado == "PENDIENTE")
                        {
                            <form asp-controller="Polizas" asp-action="CobrarRecibo" asp-route-id="@pol.IdPoliza" method="post" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="IdRecibo" value="@rec.IdRecibo"/>
                                <input type="text" name="ReferenciaPago" value="PAG-@rec.NumeroCuota.ToString("00")" required maxlength="60" class="form-control form-control-sm font-mono" style="width: 125px;"/>
                                <button type="submit" class="btn btn-brand btn-sm">Cobrar</button>
                            </form>
                        }
                        else
                        {
                            <small class="font-mono text-muted">@rec.FechaCobro?.ToString("yyyy-MM-dd") · @rec.ReferenciaPago</small>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Siniestros -->
<div class="row g-4">
    <div class="col-lg-5">
        <form asp-controller="Polizas" asp-action="RegistrarSiniestro" asp-route-id="@pol.IdPoliza" method="post" class="panel-card p-4">
            <h2 class="h6 fw-bold mb-3">Registrar Siniestro</h2>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold">Fecha *</label>
                    <input name="FechaOcurrencia" value="@fechaSiniestroSugerida" type="date" required class="form-control font-mono"/>
                </div>
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold">Monto Reclamado *</label>
                    <input name="MontoReclamado" value="2500.00" type="number" step="0.01" min="0.01" required class="form-control font-mono"/>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Descripción *</label>
                    <input name="Descripcion" required maxlength="300" class="form-control" placeholder="Ej. Colisión en intersección"/>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top text-end">
                <button type="submit" class="btn btn-brand">Registrar</button>
            </div>
        </form>
    </div>

    <div class="col-lg-7">
        <div class="panel-card overflow-hidden h-100">
            <div class="px-4 py-3 border-bottom fw-semibold">Siniestros</div>
            @if (Model.Siniestros.Count == 0)
            {
                <div class="p-4 text-muted">Sin siniestros registrados.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                        <tr>
                            <th class="ps-4">Nº</th>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th class="text-end">Reclamado</th>
                            <th class="text-end">Deducible</th>
                            <th class="text-end">Indemnizar</th>
                            <th class="pe-4">Estado</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var sin in Model.Siniestros)
                        {
                            var sinBadge = sin.Estado == "PAGADO"
                                ? "bg-success-subtle text-success-emphasis border border-success-subtle"
                                : "bg-warning-subtle text-warning-emphasis border border-warning-subtle";

                            <tr>
                                <td class="ps-4 font-mono fw-semibold">@sin.NumeroSiniestro</td>
                                <td class="font-mono">@sin.FechaOcurrencia.ToString("yyyy-MM-dd")</td>
                                <td>@sin.Descripcion</td>
                                <td class="text-end font-mono">$@sin.MontoReclamado.ToString("N2")</td>
                                <td class="text-end font-mono">$@sin.MontoDeducible.ToString("N2")</td>
                                <td class="text-end font-mono fw-semibold">$@sin.MontoIndemnizar.ToString("N2")</td>
                                <td class="pe-4">
                                    <span class="badge @sinBadge">@sin.Estado</span>
                                    @if (sin.Estado == "REGISTRADO")
                                    {
                                        <form asp-controller="Polizas" asp-action="PagarSiniestro" asp-route-id="@pol.IdPoliza" method="post" class="mt-1">
                                            <input type="hidden" name="idSiniestro" value="@sin.IdSiniestro"/>
                                            <button type="submit" class="btn btn-brand btn-sm">Pagar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
